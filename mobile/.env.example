# From your Supabase project: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# RevenueCat > Project settings > API keys > Apple App Store public key (starts with appl_)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Support email shown in the Privacy Policy, Terms and Profile > Contact support
EXPO_PUBLIC_SUPPORT_EMAIL=
